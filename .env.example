# Ads engine storage. When SUPABASE_URL + SUPABASE_SECRET_KEY are set, the
# ledger/crm rows go to Supabase tables (ads_ledger / ads_crm) via the REST
# API. Without them the engine falls back to CSV files (offline/tests).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# The engine itself is stdlib-only; all copy/config lives in brief.md,
# calendar.yml and platforms/. The vars below are only used by the optional
# web wrapper (../platform/apps/ads/server.mjs):

# Root of the ads project (default: the sibling `ads` directory)
ADS_DIR=

# Python interpreter for `engine` commands (default: auto-detect python3)
ADS_PYTHON=

# Bind host/port for the wrapper dashboard (default 127.0.0.1:4901)
HOST=127.0.0.1
PORT=4901
