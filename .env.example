# The ads engine itself is stdlib-only and needs no environment variables —
# all copy/config lives in brief.md, calendar.yml and platforms/.
#
# These vars are only used by the optional web wrapper
# (../platform/apps/ads/server.mjs) when ads runs under the platform:

# Root of the ads project (default: the sibling `ads` directory)
ADS_DIR=

# Python interpreter for `engine` commands (default: auto-detect python3)
ADS_PYTHON=

# Bind host/port for the wrapper dashboard (default 127.0.0.1:4901)
HOST=127.0.0.1
PORT=4901
